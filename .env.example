# Copy to .env.local for local development; set the same variables in Vercel → Project → Settings → Environment Variables.

# Public URL of the site (canonical links, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://born2be.media

# Form submissions: sent to ADMIN_EMAIL (comma-separated list is allowed), from MAIL_FROM.
# Same as Contact Form 7 on WordPress: to/from contact@born2be.media.
ADMIN_EMAIL=contact@born2be.media
MAIL_FROM=contact@born2be.media

# Option 1 (used on WordPress via WP Mail SMTP): Gmail API OAuth for the sending mailbox.
# OAuth client from Google Cloud Console + a refresh token with the https://mail.google.com/ scope.
GMAIL_USER=contact@born2be.media
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Option 2 (used when GMAIL_* is empty): SMTP login.
# Google Workspace: smtp.gmail.com, port 465, SMTP_PASS = an App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
