# Copy to .env.local for local development; set the same variables in Vercel → Project → Settings → Environment Variables.

# Public URL of the site (canonical links, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://born2be.media

# Where form submissions are sent (comma-separated list is allowed)
ADMIN_EMAIL=contact@born2be.media

# SMTP account that sends the emails. Google Workspace: smtp.gmail.com, port 465,
# SMTP_USER = the mailbox, SMTP_PASS = an App Password (not the normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional, defaults to SMTP_USER. E.g. "Born2be Media <contact@born2be.media>"
MAIL_FROM=
